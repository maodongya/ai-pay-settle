<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.payment</groupId>
    <artifactId>pay-settle</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>pay-settle</name>
    <description>Payment clearing and settlement platform</description>

    <modules>
        <module>pay-common</module>
        <module>pay-mq</module>
        <module>pay-api</module>
        <module>pay-domain</module>
        <module>pay-fee</module>
        <module>pay-calc</module>
        <module>pay-split</module>
        <module>pay-settlement</module>
        <module>pay-control</module>
        <module>pay-access</module>
        <module>pay-app</module>
        <module>pay-test</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <dynamic-datasource.version>4.3.1</dynamic-datasource.version>
        <shardingsphere.version>5.5.1</shardingsphere.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.payment</groupId>
                <artifactId>pay-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payment</groupId>
                <artifactId>pay-mq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payment</groupId>
                <artifactId>pay-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payment</groupId>
                <artifactId>pay-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payment</groupId>
                <artifactId>pay-fee</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payment</groupId>
                <artifactId>pay-calc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payment</groupId>
                <artifactId>pay-split</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payment</groupId>
                <artifactId>pay-settlement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payment</groupId>
                <artifactId>pay-control</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.payment</groupId>
                <artifactId>pay-access</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>dynamic-datasource-spring-boot3-starter</artifactId>
                <version>${dynamic-datasource.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-jdbc</artifactId>
                <version>${shardingsphere.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
